{
  "dialogs": [
    {
      "dialog_id": "matej_intro",
      "start_node": "start",
      "nodes": [
        {
          "id": "start",
          "speaker": "Matěj",
          "text": "Nuže, cizinče, jestli chceš mezi námi obstáti, pomoz nejprve s vodou.",
          "choices": [
            {
              "text": "Pomohu ti. Kam mám jíti?",
              "next": "give_task",
              "style": "polite",
              "forbid_flag": "quest_matej_water_started"
            },
            {
              "text": "Nemám na to času.",
              "next": "refuse",
              "style": "neutral",
              "forbid_flag": "quest_matej_water_started"
            },
            {
              "text": "Nesu vodu, jak jsi chtěl.",
              "next": "turnin",
              "style": "polite",
              "require_flag": "quest_matej_water_ready",
              "forbid_flag": "quest_matej_water_done"
            },
            {
              "text": "Děkuji ti za pomoc a přístřeší.",
              "next": "after_reward",
              "style": "polite",
              "require_flag": "quest_matej_water_done"
            }
          ]
        },
        {
          "id": "give_task",
          "speaker": "Matěj",
          "text": "Jdi ke studni na návsi a dones vodu. Pak se vrať za mnou.",
          "choices": [
            {
              "text": "Rozumím.",
              "next": "end_started",
              "set_flag": "quest_matej_water_started",
              "close_dialog": true
            }
          ]
        },
        {
          "id": "refuse",
          "speaker": "Matěj",
          "text": "Jak chceš. Bez práce však zde sotva kdo dojde chleba.",
          "choices": [
            {
              "text": "Vrátím se později.",
              "next": "end_refuse",
              "close_dialog": true
            }
          ]
        },
        {
          "id": "turnin",
          "speaker": "Matěj",
          "text": "Dobře. Vidím, že nejsi darmošlap. Anna ti dá najíst a ve stodole můžeš přespat.",
          "choices": [
            {
              "text": "Děkuji.",
              "next": "end_reward",
              "set_flag": "quest_matej_water_done",
              "close_dialog": true
            }
          ]
        },
        {
          "id": "after_reward",
          "speaker": "Matěj",
          "text": "Nuže, nyní už víš, jak to u nás chodí. Kdo pracuje, ten nezůstane o hladu.",
          "choices": [
            {
              "text": "Rozumím.",
              "next": "end_after",
              "close_dialog": true
            }
          ]
        },
        {
          "id": "end_started",
          "speaker": "Matěj",
          "text": "",
          "choices": []
        },
        {
          "id": "end_refuse",
          "speaker": "Matěj",
          "text": "",
          "choices": []
        },
        {
          "id": "end_reward",
          "speaker": "Matěj",
          "text": "",
          "choices": []
        },
        {
          "id": "end_after",
          "speaker": "Matěj",
          "text": "",
          "choices": []
        }
      ]
    }
   ,
    {
      "dialog_id": "benes_intro",
      "start_node": "start",
      "nodes": [
        {
          "id": "start",
          "speaker": "Beneš",
          "text": "Jestli chceš k železu, nezačínej sekerou. Hřebík ukáže ruku rychleji než chlouba.",
          "choices": [
            {
              "text": "Chci se učit. Dej mi první práci.",
              "next": "give_iron",
              "style": "polite",
              "forbid_flag": "quest_benes_nails_started"
            },
            {
              "text": "Mám rozdělané hřebíky.",
              "next": "work_reminder",
              "require_flag": "quest_benes_nails_started",
              "forbid_flag": "quest_benes_nails_done"
            },
            {
              "text": "Co říkáš na mou práci s hřebíky?",
              "next": "lesson_done",
              "require_flag": "smithing.nail.basic"
            },
            {
              "text": "Jen zdravím.",
              "next": "end",
              "close_dialog": true
            }
          ]
        },
        {
          "id": "give_iron",
          "speaker": "Beneš",
          "text": "Vezmi hranatou tyč, ohřej jen pracovní konec a udělej deset pokusů. Nechci rychlost, chci vidět, co dělá tvoje ruka.",
          "choices": [
            {
              "text": "Začnu u výhně.",
              "next": "end",
              "set_flag": "quest_benes_nails_started",
              "close_dialog": true
            }
          ]
        },
        {
          "id": "work_reminder",
          "speaker": "Beneš",
          "text": "Výheň, kovadlina, špička, oddělit, hlava a kontrola. Každý kus počítám, i zmetek.",
          "choices": [
            {
              "text": "Jdu na to.",
              "next": "end",
              "close_dialog": true
            }
          ]
        },
        {
          "id": "lesson_done",
          "speaker": "Beneš",
          "text": "Základ máš zapsaný. Hřebík není mistrovství, ale bez něj kovář nepozná vlastní kladivo.",
          "choices": [
            {
              "text": "Rozumím.",
              "next": "end",
              "close_dialog": true
            }
          ]
        },
        {
          "id": "end",
          "speaker": "Beneš",
          "text": "",
          "choices": []
        }
      ]
    },
    {
      "dialog_id": "new_dialog",
